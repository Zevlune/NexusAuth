{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning",
      "Npgsql": "Warning"
    }
  },
  "LuckLogging": {
    "Module": "NexusAuth.Workbench",
    "FilePath": "logs/nexusauth-workbench-.log",
    "MinimumLevel": "Information",
    "MinimumLevelOverrides": {
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System": "Warning",
      "Npgsql": "Warning"
    },
    "FileSizeLimitBytes": 104857600,
    "RetainedFileCountLimit": 30,
    "RollOnFileSizeLimit": true,
    "Shared": true,
    "FlushIntervalSeconds": 1
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "",
    "Audience": "nexusauth.workbench.api",
    "RequireHttpsMetadata": true,
    "ClientId": "nexusauth.workbench",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5051/signin-oidc",
    "PostLogoutRedirectUri": "http://localhost:5273/",
    "Scope": "openid profile offline_access nexusauth.workbench.api",
    "SignOutProvider": true,
    "FlowState": {
      "Provider": "InMemory",
      "Capacity": 10000,
      "Lifetime": "00:10:00",
      "Redis": {
        "Configuration": "",
        "KeyPrefix": "NexusAuth:oidc:flow",
        "Database": -1
      }
    }
  },
  "Security": {
    "CookieSecurePolicy": "Always",
    "ForwardedHeadersEnabled": false,
    "ForwardLimit": 1,
    "KnownProxies": "",
    "KnownNetworks": ""
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Swagger": {
    "Enabled": null
  },
  "Bootstrap": {
    "ResourceName": "nexusauth.workbench.api",
    "ResourceDisplayName": "NexusAuth Workbench API",
    "ResourceDescription": "Workbench administration API",
    "ClientName": "NexusAuth Workbench",
    "ClientDescription": "Workbench BFF client"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 465,
    "Security": "SslOnConnect",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "NexusAuth Workbench",
    "VerificationCodeCooldownSeconds": 60,
    "VerificationCodeLifetimeMinutes": 5
  }
}
