{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LuckLogging": {
    "Module": "NexusAuth.Workbench",
    "FilePath": "logs/nexusauth-workbench-.log"
  },
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=33210;Database=nexusauth;Username=nexusauth;Password=nexusauth_dev_password;Search Path=nexusauth"
  },
  "Auth": {
    "Authority": "http://localhost:5100",
    "RequireHttpsMetadata": false,
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5273/signin-oidc",
    "PostLogoutRedirectUri": "http://localhost:5273/"
  },
  "Security": {
    "CookieSecurePolicy": "SameAsRequest"
  }
}
