{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning",
      "Npgsql": "Warning"
    }
  },
  "LuckLogging": {
    "Module": "NexusAuth.SSO",
    "FilePath": "logs/nexusauth-sso-.log",
    "MinimumLevel": "Information",
    "MinimumLevelOverrides": {
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System": "Warning",
      "Npgsql": "Warning"
    },
    "FileSizeLimitBytes": 104857600,
    "RetainedFileCountLimit": 30,
    "RollOnFileSizeLimit": true,
    "Shared": true,
    "FlushIntervalSeconds": 1
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=nexusauth;Username=replace-me;Password=replace-me;Search Path=nexusauth"
  },
  "ClientIp": {
    "ForwardedHeadersEnabled": false,
    "KnownProxies": "",
    "KnownNetworks": "",
    "ForwardLimit": 1
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.qq.com",
    "Port": 465,
    "Security": "SslOnConnect",
    "Username": "test@qq.com",
    "Password": "",
    "FromAddress": "test@qq.com",
    "FromName": "NexusAuth",
    "VerificationCodeCooldownSeconds": 60,
    "VerificationCodeLifetimeMinutes": 5
  },
  "Jwt": {
    "Issuer": "http://localhost:5100",
    "DefaultAudience": "NexusAuth",
    "SigningMode": "Certificate",
    "SigningPath": "",
    "SigningPassword": null,
    "SigningCertificatePath": "",
    "SigningCertificatePassword": "",
    "DevelopmentSigningCertificatePath": "App_Data/development-signing-certificate.pfx",
    "DevelopmentSigningCertificatePassword": "",
    "SigningKeyPath": "",
    "DevelopmentSigningKeyPath": "App_Data/signing-key.json",
    "SigningKeys": [],
    "AccessTokenLifetimeMinutes": 60,
    "DeviceCodeLifetimeMinutes": 15,
    "RefreshTokenLifetimeMinutes": 43200
  },
  "Security": {
    "ClientWhitelist": [],
    "ClientBlacklist": [],
    "UserWhitelist": [],
    "UserBlacklist": [],
    "LoginFailureLimit": 5,
    "LoginLockoutMinutes": 5,
    "CookieSecurePolicy": "SameAsRequest"
  },
  "LoginFlow": {
    "PendingStateLifetimeMinutes": 5,
    "SessionLifetimeMinutes": 1440,
    "RememberMeLifetimeDays": 3,
    "AllowRememberMe": true,
    "Steps": [
      { "Type": "password", "Requirement": "required" },
      { "Type": "totp", "Requirement": "conditional" }
    ]
  },
  "LoginPage": {
    "BrandName": "NexusAuth",
    "BrandLogoUrl": "/brand/nexusauth-logo.svg",
    "MarketingHeading": "基于 OAuth 2.1 与 OIDC 的统一身份认证",
    "MarketingDescription": "支持 OAuth 2.1、OpenID Connect（OIDC）、授权码 + PKCE 和 SCIM 2.0 标准协议。",
    "LoginTitle": "Sign In",
    "LoginSubtitle": "Please enter your details to sign in."
  },
  "SelfRegistration": { "Enabled": false },
  "Scim": { "Enabled": true },
  "WeChat": {
    "MiniProgram": {
      "Enabled": false,
      "ClientId": "wechat-miniapp",
      "AppId": "",
      "AppSecret": "",
      "Code2SessionEndpoint": "https://api.weixin.qq.com/sns/jscode2session",
      "AutoProvisionUsers": true
    }
  },
  "WebAuthn": {
    "Enabled": false,
    "RelyingPartyId": "localhost",
    "RelyingPartyName": "WebAuthn NexusAuth",
    "Origins": ["http://localhost:5200"],
    "ChallengeLifetimeSeconds": 300,
    "UserVerification": "required"
  },
  "Totp": { "Issuer": "NexusAuth", "EnrollmentLifetimeMinutes": 10 },
  "SliderCaptcha": {
    "Enabled": false,
    "ChallengeLifetimeSeconds": 120,
    "TolerancePixels": 5,
    "TrackWidthPixels": 300
  },
  "BootstrapAdmin": {
    "Username": "",
    "Password": "",
    "Nickname": "System Admin",
    "Email": "",
    "PromoteExistingUser": false
  },
  "DataRetention": {
    "Enabled": true,
    "SweepIntervalMinutes": 5,
    "ExpiredDataRetentionDays": 7,
    "LoginAuditRetentionDays": 180,
    "CleanupBatchSize": 1000,
    "MaxBatchesPerTypePerSweep": 20
  },
  "Swagger": { "Enabled": null }
}
