@page "/account/forgot-password"
@model NexusAuth.Host.Pages.Account.ForgotPasswordModel
@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>找回密码 - NexusAuth</title>
<style>
:root { --border:#293158;--page-bg:#111735;--field-bg:#0c122e;--brand-blue:#7ca3ff;--button-text:#fff;--form-muted:#a6acc7;--form-heading:#eef0ff; }
*{box-sizing:border-box}body{margin:0;background:#090d25;color:#eef0ff;font:14px/1.6 system-ui}main{max-width:480px;margin:40px auto;padding:28px;background:#111735;border:1px solid #293158;border-radius:12px}form,label{display:grid;gap:10px}form{gap:18px}input,button{font:inherit;border-radius:6px;padding:10px;border:1px solid #293158}input{background:#0c122e;color:#fff}button{background:#7ca3ff;color:#fff;cursor:pointer}a{color:#7ca3ff}.error{color:#ffaaa2}.slider-captcha-dialog{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#000a;padding:16px}.hidden{display:none}.captcha-card{background:var(--page-bg);color:var(--form-heading)}.captcha-header{display:flex;justify-content:space-between}.captcha-header h2{margin:0}.captcha-header p{margin:4px 0}.captcha-close{background:transparent;border:0}.slider-captcha-scene{position:relative;overflow:hidden}.captcha-image{width:100%;height:100%;display:block}.slider-captcha-piece{position:absolute}.captcha-track{position:relative;height:48px;overflow:hidden;background:var(--field-bg)}.captcha-handle{position:absolute;left:0;top:0;width:48px;height:48px;touch-action:none}.captcha-progress{position:absolute;inset:0;transform-origin:left;background:#7ca3ff33}.captcha-instruction{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;color:var(--form-muted)}
</style><link rel="stylesheet" href="/css/slider-captcha.css" asp-append-version="true" /></head><body><main>
<h1>找回密码</h1><p>使用账号绑定的邮箱。绑定过身份验证器的账号还需动态码。</p>
@if (Model.Message != null) { <p role="status">@Model.Message</p> }
@if (Model.Error != null) { <p class="error" role="alert">@Model.Error</p> }
<form id="login-form" method="post">
<input id="slider-captcha-token" type="hidden" asp-for="SliderCaptchaToken" /><input id="slider-captcha-offset" type="hidden" asp-for="SliderCaptchaOffset" />
<label>邮箱<input asp-for="EmailAddress" type="email" required autocomplete="email" maxlength="254" data-email-validate aria-describedby="EmailAddress-error" aria-invalid="false" /></label>
<span id="EmailAddress-error" class="field-validation-message" data-email-field-error="EmailAddress" role="alert"></span>
<div class="email-code-field"><label asp-for="Code">邮箱验证码</label><div class="email-code-row">
<input asp-for="Code" aria-label="邮箱验证码" placeholder="请输入邮箱验证码" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
<button asp-page-handler="Send" formnovalidate data-email-send data-send-cooldown="@Model.ConfiguredSendCooldownSeconds" data-email-input="[name=EmailAddress]" data-cooldown-seconds="@Model.SendCooldownSeconds">发送验证码</button>
</div></div>
<label>新密码<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></label>
<label>确认新密码<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></label>
<label>动态码（已绑定身份验证器时必填）<input asp-for="TotpCode" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /></label>
<button asp-page-handler="Reset">验证并重置密码</button></form><p><a href="/account/login">返回登录</a></p></main>
@if (Model.Images is { } images) {
<div id="slider-captcha-dialog" class="slider-captcha-dialog hidden" role="dialog" aria-modal="true" aria-labelledby="slider-captcha-title"><div class="captcha-card"><div class="captcha-header"><div><h2 id="slider-captcha-title">安全验证</h2><p>拖动滑块，将拼图移动到缺口位置。</p></div><button id="slider-captcha-close" class="captcha-close" type="button" aria-label="关闭验证">×</button></div><div id="slider-captcha-scene" class="slider-captcha-scene" data-track-width="@Model.SliderCaptchaTrackWidthPixels"><img class="captcha-image" src="@images.ImageDataUrl" alt="滑块验证码背景" /><img id="slider-captcha-piece" class="slider-captcha-piece" src="@images.PieceDataUrl" data-size="@images.PieceSize" data-top="@images.PieceTop" data-width="@images.Width" data-height="@images.Height" alt="" /></div><div id="slider-captcha-track" class="captcha-track"><div id="slider-captcha-progress" class="captcha-progress"></div><span class="captcha-instruction">按住滑块向右拖动</span><button id="slider-captcha-handle" type="button" class="captcha-handle" aria-label="拖动滑块">»</button></div><div class="captcha-tools"><span>完成拼图以继续</span><button id="slider-captcha-refresh" type="button">↻ 换一张</button></div><p id="slider-captcha-status" role="status"></p></div></div>
}
<link rel="stylesheet" href="/css/email-code.css" asp-append-version="true" />
<script src="/js/slider-captcha.js" asp-append-version="true" defer></script>
<script src="/js/email-code.js" asp-append-version="true" defer></script></body></html>
