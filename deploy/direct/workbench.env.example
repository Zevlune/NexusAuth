ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
NEXUSAUTH_WORKBENCH_GATEWAY_ENABLED=false
NEXUSAUTH_WORKBENCH_CONNECTION_STRINGS_DEFAULT=Host=db;Port=5432;Database=nexusauth;Username=nexusauth;Password=REPLACE_WITH_DATABASE_PASSWORD;Search Path=nexusauth
NEXUSAUTH_WORKBENCH_AUTH_AUTHORITY=https://sso.example.com
NEXUSAUTH_WORKBENCH_AUTH_CLIENT_SECRET=REPLACE_WITH_WORKBENCH_CLIENT_SECRET
NEXUSAUTH_WORKBENCH_AUTH_REDIRECT_URI=https://workbench.example.com/signin-oidc
NEXUSAUTH_WORKBENCH_AUTH_POST_LOGOUT_REDIRECT_URI=https://workbench.example.com/
NEXUSAUTH_WORKBENCH_BOOTSTRAP_RESOURCE_NAME=nexusauth.workbench.api
NEXUSAUTH_WORKBENCH_BOOTSTRAP_RESOURCE_DISPLAY_NAME=NexusAuth Workbench API
NEXUSAUTH_WORKBENCH_BOOTSTRAP_CLIENT_NAME=NexusAuth Workbench

# TLS is required by default; configure the TLS ingress before logging in.
NEXUSAUTH_WORKBENCH_AUTH_REQUIRE_HTTPS_METADATA=true
NEXUSAUTH_WORKBENCH_SECURITY_COOKIE_SECURE_POLICY=Always
NEXUSAUTH_WORKBENCH_SWAGGER_ENABLED=false
# Enable forwarding only with the actual ingress IP/CIDR allowlist.
NEXUSAUTH_WORKBENCH_SECURITY_FORWARDED_HEADERS_ENABLED=false
NEXUSAUTH_WORKBENCH_SECURITY_KNOWN_PROXIES=
NEXUSAUTH_WORKBENCH_SECURITY_KNOWN_NETWORKS=
